<% layout("layouts/boilerplate.ejs") -%>

<div class="d-flex justify-content-center align-items-centermt-4 my-5">
  <div
    class="card shadow-sm p-2 p-md-4 rounded-4 w-100"
    style="max-width: 380px"
  >
    <h2 class="text-center mb-4 fw-bold text-signup text-dark">Sign Up</h2>
    <p class="text-center logo mb-4">WanderLust</p>

    <form
      action="/user/signup"
      method="POST"
      class="needs-validation"
      novalidate
    >
      <div class="mb-3 w-sm-100">
        <input
          type="email"
          class="form-control w-sm-100"
          id="email"
          name="email"
          placeholder="Email"
          required
        />
        <div class="invalid-feedback">Enter valid email</div>
      </div>

      <div class="mb-3 w-sm-100">
        <input
          type="text"
          class="form-control w-sm-100"
          id="username"
          name="username"
          placeholder="Username"
          required
        />
        <div class="invalid-feedback">Enter valid username</div>
      </div>

      <div class="mb-3 w-sm-100">
        <input
          type="password"
          class="form-control w-sm-100"
          id="password"
          name="password"
          placeholder="Password"
          required
        />
        <div class="invalid-feedback">Enter password</div>
      </div>

      <div class="d-grid">
        <button type="submit" class="btn btn-primary fw-semibold sign">
          Sign Up
        </button>
      </div>
      <a href="/listings" class="btn btn-outline-dark mt-3 w-100 w-md-50">
        Back
      </a>
    </form>

    <div class="text-center mt-3">
      <small
        >Already have an account?
        <a href="/user/login" class="text-primary text-decoration-none"
          >Log in</a
        ></small
      >
    </div>
  </div>
</div>
