<% layout("/layouts/boilerplate.ejs") %>

<style>
  /* Keep body background only — remove flex from body */
  body {
    background: linear-gradient(135deg, #89f7fe, #66a6ff);
    min-height: 100vh;
  }

  /* New wrapper for centering the card */
  .profile-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(100vh - 80px); /* avoid navbar overlap */
  }

  .profile-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 40px;
    max-width: 600px;
    width: 100%;
    box-shadow: 0 6px 25px rgba(0, 0, 0, 0.15);
    animation: fadeIn 0.6s ease-in-out;
  }

  .profile-header h3 {
    font-weight: 700;
    color: #333;
  }

  .profile-header h5 {
    color: #555;
  }

  .profile-options {
    margin-top: 25px;
  }

  .profile-options ul {
    list-style: none;
    padding: 0;
  }

  .profile-options ul li {
    margin-bottom: 12px;
  }

  .profile-options a {
    text-decoration: none;
    font-size: 16px;
    color: #007bff;
    transition: 0.2s;
  }

  .profile-options a:hover {
    color: #0056b3;
    text-decoration: underline;
  }

  .logout a {
    padding: 10px 25px;
    border-radius: 10px;
  }

  .delete-section {
    background: #ffe9e9;
    border-left: 5px solid #ff4a4a;
    padding: 20px;
    border-radius: 12px;
    margin-top: 30px;
  }

  .delete-section p {
    font-weight: 600;
    color: #b30000;
    margin-bottom: 10px;
  }

  .delete-section button {
    border-radius: 10px;
    padding: 8px 20px;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<% if (currUser) { %>
<br>
<div class="profile-wrapper">
  <div class="profile-card">

    <div class="profile-header text-center">
      <h3><i class="fa-solid fa-circle-user"></i> @<%= currUser.username %></h3>
      <h5>User Email: <%= currUser.email %></h5>
    </div>

    <div class="profile-options">
      <ul>
        <li><a href="/user/profile/userList"><i class="fa-solid fa-eye"></i> My Listings</a></li>
        <li><a href="/user/profile/userReviews"><i class="fa-solid fa-star"></i> Your Reviews & ratings</a></li>
      </ul>
    </div>

    <div class="logout text-center mt-4">
      <a class="btn btn-danger" href="/user/logout"><b>Logout</b></a>
    </div>

    <br>
    <a href="/listings" class="back-button btn btn-outline-dark">Back</a>
      <br /><br />

    <div class="delete-section mt-4">
      <p>Delete Account Permanently:</p>
      <form action="/user/delete-account?_method=DELETE" method="post">
        <button class="btn btn-danger"
          onclick="return confirm('Are you sure you want to delete your account permanently?');">
          Delete Account
        </button>
      </form>
    </div>

  </div>
</div>
<br>
<% } %>
