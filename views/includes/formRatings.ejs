<div class="d-flex justify-content-between align-items-center mb-2">
  <div>
    <strong><small>Rating:</small></strong>

    <% let reviewCount = list.reviews ? list.reviews.length : 0; let fullStars =
    Math.floor(avg); let halfStar = (avg % 1 !== 0); let emptyStars = 5 -
    fullStars - (halfStar ? 1 : 0); %> <% if (reviewCount === 0) { %> <% for
    (let i = 0; i < 5; i++) { %>
    <small><i class="fa-regular fa-star text-warning"></i></small>
    <% } %>
    <small>(0/5)</small>
    <% } else { %>
    <!-- Full stars -->
    <% for (let i = 0; i < fullStars; i++) { %>
    <small><i class="fa-solid fa-star text-warning"></i></small>
    <% } %>

    <!-- Half star -->
    <% if (halfStar) { %>
    <small><i class="fa-solid fa-star-half-stroke text-warning"></i></small>
    <% } %>

    <!-- Empty stars -->
    <% for (let i = 0; i < emptyStars; i++) { %>
    <small><i class="fa-regular fa-star text-warning"></i></small>
    <% } %>

    <small>(<%= avg.toFixed(1) %>/5)</small>
    <% } %>
  </div>

  <!-- Total Reviews -->
  <% const isShow = typeof show !== "undefined" ? show : false; %> <% if
  (isShow) { %>
  <div>
    <small>
      <a href="#review" class="text-decoration-none">
        <strong>Total Reviews: <%= reviewCount %></strong>
      </a>
    </small>
  </div>
  <% } %>
</div>
