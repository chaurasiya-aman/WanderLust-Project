<% if (success && success.length) { %>
<div class="alert alert-success alert-dismissible fade show text-center my-2">
  <h6><%= success[0] %></h6>
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
<% } %> 



<% if (warning && warning.length) { %>
<div class="alert alert-warning alert-dismissible fade show text-center my-2">
  <h6><%= warning[0] %></h6>
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
<% } %> 



<% if (danger && danger.length) { %>
<div class="alert alert-danger alert-dismissible fade show text-center my-2">
  <h6><%= danger[0] %></h6>
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
<% } %>


<% if (error && error.length) { %>
<div class="alert alert-danger alert-dismissible fade show text-center my-2">
  <h6><%= error[0] %></h6>
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
<% } %>
