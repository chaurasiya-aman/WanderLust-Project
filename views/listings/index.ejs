<% layout("layouts/boilerplate.ejs") -%>
<style>
#filters {
  padding: 0.2rem;
}

.filter-icon {
  text-align: center;
  opacity: 0.7;
  transition: 0.25s ease-in-out;
  padding: 0.5rem;
  border-radius: 10px;
}

.filter-icon i {
  transition: 0.25s ease-in-out;
  font-size: 1.1rem;
}

.filter-icon p {
  font-size: 0.6rem;
  margin-bottom: 5px;
}

.filter-icon:hover {
  opacity: 1;
  transform: scale(1.07);
  cursor: pointer;
}

.farms:hover { background-color: #c19a6b33; }
.farms:hover i { color: #8b5e3c; }

.rooms:hover { background-color: #b8b8ff33; }
.rooms:hover i { color: #4b4bb8; }

.mountains:hover { background-color: #98fb9833; }
.mountains:hover i { color: #228b22; }

.pool:hover { background-color: #87cefa33; }
.pool:hover i { color: #1e90ff; }

.beach:hover { background-color: #ffeb9933; }
.beach:hover i { color: #e6b800; }

.boats:hover { background-color: #add8e633; }
.boats:hover i { color: #0077b6; }

.iconic-cities:hover { background-color: #ffc0cb33; }
.iconic-cities:hover i { color: #ff4081; }

.snowy:hover { background-color: #cce6ff55; }
.snowy:hover i { color: #4da6ff; }

.camping:hover { background-color: #90ee9033; }
.camping:hover i { color: #2e8b57; }

@media (max-width: 320px) {
  .filter-icon {
    width: 40px;
  }
}
</style>
<div class="container my-4">
  <!-- <h2 class="text-center text-color-custome fw-bold mb-4">
    Find Your Perfect Stay
  </h2> -->
  <div id="filters">
    <div id="toggle-tax">
      <div class="form-check-reverse form-switch">
        <input
          class="form-check-input"
          type="checkbox"
          role="switch"
          id="switchCheckDefault"
        />
        <label class="form-check-label" for="switchCheckDefault"
          >See Total With Taxes</label
        >
      </div>
    </div>
    <!-- Collapse toggle button (visible on small devices) -->
    <button
      class="btn btn-outline-secondary d-lg-none mb-2"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#filterCollapse"
    >
      <i class="fa-solid fa-filter"></i> Filters
    </button>

    <div class="collapse d-lg-block" id="filterCollapse">
      <div id="filters" class="d-flex gap-3 px-3 py-2">
        <a
          href="/listings/category/farms"
          class="filter-icon farms text-center text-decoration-none text-dark"
        >
          <i class="fa-solid fa-cow"></i>
          <p>Farms</p>
        </a>

        <a
          href="/listings/category/rooms"
          class="filter-icon rooms text-center text-decoration-none text-dark"
        >
          <i class="fa-solid fa-bed"></i>
          <p>Rooms</p>
        </a>

        <a
          href="/listings/category/mountains"
          class="filter-icon mountains text-center text-decoration-none text-dark"
        >
          <i class="fa-solid fa-mountain-sun"></i>
          <p>Mountains</p>
        </a>

        <a
          href="/listings/category/pool"
          class="filter-icon pool text-center text-decoration-none text-dark"
        >
          <i class="fa-solid fa-person-swimming"></i>
          <p>Amazing Pool</p>
        </a>

        <a
          href="/listings/category/beach"
          class="filter-icon beach text-center text-decoration-none text-dark"
        >
          <i class="fa-solid fa-umbrella-beach"></i>
          <p>Beach</p>
        </a>

        <a
          href="/listings/category/boats"
          class="filter-icon boats text-center text-decoration-none text-dark"
        >
          <i class="fa-solid fa-sailboat"></i>
          <p>Boats</p>
        </a>

        <a
          href="/listings/category/iconic-cities"
          class="filter-icon iconic-cities text-center text-decoration-none text-dark"
        >
          <i class="fa-solid fa-city"></i>
          <p>Iconic Cities</p>
        </a>

        <a
          href="/listings/category/snowy"
          class="filter-icon snowy text-center text-decoration-none text-dark"
        >
          <i class="fa-regular fa-snowflake"></i>
          <p>Snowy</p>
        </a>

        <a
          href="/listings/category/camping"
          class="filter-icon camping text-center text-decoration-none text-dark"
        >
          <i class="fa-solid fa-campground"></i>
          <p>Camping</p>
        </a>
      </div>
    </div>
  </div>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-3 g-4">
    <% for (let listings of allListings) { %> <% let total = 0; let count =
    listings.reviews && listings.reviews.length ? listings.reviews.length : 0;
    if (count > 0) { for (let r of listings.reviews) { total += r.rating || 0; }
    } let avg = count > 0 ? total / count : 0; %>

    <div class="col">
      <a
        href="/listings/<%= listings._id %>"
        class="text-decoration-none text-dark"
      >
        <div
          class="card listing-card custome h-100 shadow-sm hover-shadow home-card"
        >
          <img
            src="<%= listings.image.url %>"
            class="card-img-top fixed-img"
            alt="place_image"
          />
          <div class="card-body">
            <h6><%= listings.title %></h6>
            <small
              ><b><%= listings.location %>, <%= listings.country %></b></small
            >

            <%- include("../includes/formRatings.ejs", { list: listings, avg })
            %>

            <p class="card-text mb-0">
              ₹<%= listings.price.toLocaleString("en-IN") %>/night
              <i class="tax-info">+18% GST</i>
            </p>
          </div>
        </div>
      </a>
    </div>
    <% } %>
  </div>
</div>
<script>
  const toggleBtn = document.getElementById("switchCheckDefault");
  toggleBtn.addEventListener("click", () => {
    console.log("clicked");
    let taxbtn = document.getElementsByClassName("tax-info");
    for (info of taxbtn) {
      if (info.style.visibility != "visible") {
        info.style.visibility = "visible";
      } else {
        info.style.visibility = "hidden";
      }
    }
  });
</script>
