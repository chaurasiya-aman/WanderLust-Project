<% layout("layouts/boilerplate.ejs") -%> <%let show=1%>
<script>
  window.coordinates = <%- JSON.stringify(list.geometry.coordinates) %>;
  window.loc = ["<%= list.location %>", "<%= list.country %>"];
</script>
<div class="row">
  <div class="col-12 col-md-8 col-lg-6 offset-md-2 offset-lg-3">
    <div class="card mt-4 w-100">
      <img
        src="<%= list.image.url %>"
        class="card-img-top"
        alt="listing image"
      />
      <div class="card-body">
        <h4><%= list.title %></h4>
        <p>
          <small>Owned By <i>@<%=list.owner.username%></i></small>
        </p>
        <%- include("../includes/formRatings.ejs",{show: true}) %>
        <p class="card-text"><%= list.description %></p>
        <b>
          <span>Location: <%= list.location %>, <%= list.country %></span>
        </b>
        <br />
        <b>
          <span>Price: ₹<%= list.price.toLocaleString("en-IN") %>/night</span>
        </b>
        <br />
      </div>
    </div>

    <% if(currUser && currUser._id.equals(list.owner._id)) {%>
    <div class="row g-3 justify-content-center mt-3">
      <div class="col-6 col-sm-4 col-md-6">
        <form action="/listings/<%= list._id %>/edit">
          <button class="btn btn-primary w-100">Edit</button>
        </form>
      </div>

      <div class="col-6 col-sm-4 col-md-6">
        <form method="post" onsubmit="return false;">
          <button type="button" id="del" class="btn btn-danger w-100">
            Delete
          </button>
        </form>
      </div>
    </div>
    <%}%>

    <a href="/listings" class="btn btn-outline-dark mt-3 w-100 w-md-50">
      Back
    </a>
    <br /><br />
    <hr />
  </div>
</div>

<%-include("../includes/reviewForm.ejs")%>
<%-include("../includes/showReview.ejs")%>
<%-include("../includes/delConfirmation.ejs")%>

<div class="row my-5">
  <div class="col-12 col-md-8 col-lg-6 offset-md-2 offset-lg-3">
    <h3>Where you'll be</h3>
    <div id="map"></div>
  </div>
</div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/javascript/map.js"></script>
<script src="/javascript/show.js"></script>
